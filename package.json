{
  "name": "solslot-evm",
  "version": "2.0.0-alpha.1",
  "description": "Solslot EVM contracts for zkPassport credential attestations.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.10.0"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "check:namespace": "python3 scripts/check_namespace.py --paths .",
    "check:secrets": "python3 scripts/check_secrets.py --paths .",
    "deploy:solslot-v2": "hardhat run scripts/deploy-solslot-v2.js",
    "deploy:solslot-v2:keystore": "bash scripts/deploy-solslot-v2-from-keystore.sh"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.11",
    "@nomicfoundation/hardhat-mocha": "3.0.13",
    "@nomicfoundation/hardhat-network-helpers": "3.0.11",
    "chai": "6.2.2",
    "dotenv": "17.4.2",
    "ethers": "6.17.0",
    "hardhat": "3.11.1",
    "mocha": "11.7.6"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "diff": "9.0.0",
    "serialize-javascript": "7.0.7"
  }
}
